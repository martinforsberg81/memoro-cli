{
  "name": "memoro-cli",
  "version": "0.7.11",
  "description": "Command-line glue between external coding tools (Claude Code, Cursor, Codex, Windsurf, Gemini CLI) and your Memoro account — session ingest, lens injection, secure token storage.",
  "type": "module",
  "bin": {
    "memoro-cli": "src/bin.js",
    "memoro": "src/bin.js",
    "mc": "src/mc-cli.js"
  },
  "main": "./src/index.js",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "scripts",
    "canon",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test 'tests/**/*.test.js'",
    "security:credential-boundary": "node scripts/security/credential-boundary-probe.mjs",
    "security:c1-source-closure": "node scripts/security/check-c1-source-closure.mjs",
    "smoke:mc": "node scripts/mc-release-smoke.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "memoro",
    "cli",
    "claude-code",
    "cursor",
    "codex",
    "ai",
    "knowledge-hub"
  ],
  "homepage": "https://meetmemoro.app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinforsberg81/memoro-cli.git"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
